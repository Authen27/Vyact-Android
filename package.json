{
  "name": "vyact-react",
  "private": true,
  "version": "10.129.0",
  "type": "module",
  "engines": { "node": "22.x" },
  "description": "Vyact — Family Finance OS · React + TypeScript + Recharts",
  "scripts": {
    "dev": "vite",
    "build": "node check-env.js && tsc -b && vite build",
    "postbuild": "node scripts/prerender-landing.mjs && node scripts/assert-no-sourcemaps.mjs && node scripts/assert-preview-isolated.mjs && node scripts/assert-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "typecheck:edge": "tsc -p ../scripts/typecheck/edge.tsconfig.json",
    "test:tz": "node scripts/test-timezones.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "e2e": "playwright test",
    "e2e:stability": "node e2e/run-stability.cjs",
    "e2e:capture": "node e2e/run-and-capture.cjs",
    "e2e:lane-b": "playwright test --config=playwright.lane-b.config.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@dinero.js/currencies": "^2.0.0-alpha.14",
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-virtual": "^3.13.25",
    "@userback/widget": "^0.3.12",
    "@vercel/speed-insights": "^2.0.0",
    "dinero.js": "^2.0.2",
    "framer-motion": "^13.4.4",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "gifenc": "^1.0.3",
    "globals": "^17.12.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "workbox-window": "^7.4.1"
  }
}
