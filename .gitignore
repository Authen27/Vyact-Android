.vercel

# Playwright E2E artifacts
/playwright-report/
/e2e/.results/
/blob-report/
/test-results/
.cache/

# tsc emit from tsconfig.node.json must never land beside the source:
# Vite resolves vite.config.js BEFORE vite.config.ts, so a stray compiled
# artifact silently becomes the build config (see tsconfig.node.json).
vite.config.js
vite.config.d.ts
/android/
/ios/
/assets/
/node_modules/
/dist/
*.tsbuildinfo

# Firebase files and keys are secrets of the build, never source. CI writes android/app/google-services.json
# from the GOOGLE_SERVICES_JSON_BASE64 secret; service-account keys live only in Supabase's secrets.
# scripts/check-overlay-registered.mjs fails the build if any of these is tracked (CLAUDE.md, "Secrets & files").
google-services.json
GoogleService-Info.plist
*-adminsdk-*.json
service-account*.json
